// examples/tiled_attention.axc — M3.3 DONE: correctness-first NON-streaming tiled attention (C1).
//
// NOT FlashAttention-2. FlashAttention-2 (streaming online softmax) is C2, deferred to M3.2b.
//
// Algorithm: O = softmax(Q·Kᵀ / sqrt(d)) · V
//
// Each workgroup (invocation) handles ONE query row.
// Dispatch geometry: (seq_len, 1, 1) workgroups — q_row = gid(0) = blockIdx.x.
//
// Correctness design (two-pass softmax):
//   Pass 1: score[j] = dot(Q[q_row], K[j]) * inv_sqrt_d; running max for stability.
//   Pass 2: denom = sum_j exp(score[j] - max_score).
//   Pass 3: O[q_row][d] = sum_j softmax_weight[j] * V[j][d].
//
// exp approximation: Taylor 1 + x + x^2/2 (kept for simplicity; CPU reference uses
// IDENTICAL formula, see AT-1630 test). The approximation is accurate for small |x|;
// after subtracting the running max, |x| << 1 for typical attention scores.
//
// M3.3 FIX: dispatch geometry was (1,1,1) → should be (seq_len,1,1) per gid(0)=q_row.
// The kernel source was already correct (gid(0)=q_row). The fix is in the host dispatch.
// The gpu=0.0 was because all workgroups had q_row=0 and wrote over each other's output.
//
// AT-1630 fixture: seq_len=64, head_dim=32, bit-exact within 1e-3 vs CPU reference.
// Runs on Lavapipe (pure f32, no coopmat) AND NVIDIA.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>`.

@kernel
@workgroup(1, 1, 1)
@intent("correctness-first NON-streaming tiled attention (C1, NOT FA2 — AT-1630)")
@complexity(O(n))
fn tiled_attention(
    Q: readonly_buffer[f32],
    K: readonly_buffer[f32],
    V: readonly_buffer[f32],
    O: buffer[f32],
    seq_len: u32,
    head_dim: u32,
    inv_sqrt_d: f32
) -> void {
    // K and V rows staged into shared memory (one row at a time).
    // head_dim is at most 64 for the correctness fixture.
    shared k_tile: shared[f32, 64];    // K-vector (one row of K matrix)
    shared v_tile: shared[f32, 64];    // V-vector (one row of V matrix)

    // Which query row this workgroup handles (dispatch: (seq_len,1,1) workgroups).
    let q_row: u32 = gid(0u32);
    let q_base: u32 = q_row * head_dim;

    // ── Pass 1: Compute score row and find max for numerical stability ──────────
    // Initialize max to a very negative value (valid f32).
    let mut max_score: f32 = -1e9f32;

    for j in range(0u32, seq_len) {
        // Stage K[j] row into shared memory.
        // Single-invocation workgroup (wg=1,1,1): this invocation loads all elements.
        let k_base: u32 = j * head_dim;
        for d in range(0u32, head_dim) {
            k_tile[d] = K[k_base + d];
        }
        workgroup_barrier();

        // Dot product: score = dot(Q[q], k_tile) * inv_sqrt_d.
        let mut score: f32 = 0.0f32;
        for d in range(0u32, head_dim) {
            let q_val: f32 = Q[q_base + d];
            let k_val: f32 = k_tile[d];
            score = score + q_val * k_val;
        }
        score = score * inv_sqrt_d;

        // Update running max for numerical stability (correct two-pass softmax).
        let is_larger: bool = score > max_score;
        if is_larger {
            max_score = score;
        }

        workgroup_barrier();
    }

    // ── Pass 2: Compute denominator: sum of exp(score[j] - max_score) ──────────
    let mut denom: f32 = 0.0f32;

    for j in range(0u32, seq_len) {
        let k_base: u32 = j * head_dim;
        for d in range(0u32, head_dim) {
            k_tile[d] = K[k_base + d];
        }
        workgroup_barrier();

        let mut score: f32 = 0.0f32;
        for d in range(0u32, head_dim) {
            let q_val: f32 = Q[q_base + d];
            let k_val: f32 = k_tile[d];
            score = score + q_val * k_val;
        }
        score = score * inv_sqrt_d;

        // exp(x) approximation: 1 + x + x^2/2 (Taylor; small |x-max| after subtraction).
        // CPU reference uses THE IDENTICAL FORMULA — see AT-1630 test.
        let x: f32 = score - max_score;
        let exp_x: f32 = 1.0f32 + x + x * x * 0.5f32;
        denom = denom + exp_x;

        workgroup_barrier();
    }

    // ── Pass 3: Normalize and accumulate output ─────────────────────────────────
    // O[q_row][d] = sum_j softmax_weight[j] * V[j][d]
    // where softmax_weight[j] = exp(score[j] - max_score) / denom.
    for d in range(0u32, head_dim) {
        let mut out_val: f32 = 0.0f32;

        for j in range(0u32, seq_len) {
            // Reload K row to recompute score (no separate score buffer).
            let k_base: u32 = j * head_dim;
            for dk in range(0u32, head_dim) {
                k_tile[dk] = K[k_base + dk];
            }
            // Stage V row.
            let v_base: u32 = j * head_dim;
            for dv in range(0u32, head_dim) {
                v_tile[dv] = V[v_base + dv];
            }
            workgroup_barrier();

            let mut score: f32 = 0.0f32;
            for dk in range(0u32, head_dim) {
                let q_val: f32 = Q[q_base + dk];
                let k_val: f32 = k_tile[dk];
                score = score + q_val * k_val;
            }
            score = score * inv_sqrt_d;

            let x: f32 = score - max_score;
            let exp_x: f32 = 1.0f32 + x + x * x * 0.5f32;
            let weight: f32 = exp_x / denom;

            let v_val: f32 = v_tile[d];
            out_val = out_val + weight * v_val;

            workgroup_barrier();
        }

        let out_idx: u32 = q_base + d;
        O[out_idx] = out_val;
    }

    return;
}
