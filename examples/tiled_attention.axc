// examples/tiled_attention.axc — WIP (M3.3): compiles + spirv-val clean; GPU numerics
// incorrect pending OpPhi loop support + kernel debugging. See M3.2-coder.json retry:2.
//
// Correctness-first NON-streaming tiled attention (PART C1).
//
// This is tiled_attention, NOT flash_attention_v2.
// FlashAttention-2 (streaming online softmax with running max/denom rescaling) is C2,
// deferred to M3.2b. The flash_attention_v2 name is RESERVED for that milestone.
//
// C1 implements: O = softmax(Q·Kᵀ / sqrt(d)) · V
//
// Algorithm:
//   For each query row q in Q (one workgroup-invocation = one query row):
//     1. Full two-pass softmax over all K positions:
//        Pass 1: compute score s[j] = dot(Q[q], K[j]) * inv_sqrt_d,
//                accumulating the dot product via individual element reads from shared.
//        Pass 2: exp(s[j] - max_s), sum, normalize.
//     2. Accumulate O[q] += weight[j] * V[j][d].
//
// The K and V rows are staged one-at-a-time into shared[f32, 64] per K-block.
// This materializes the full score row (seq_len scores per query).
// Does NOT scale to the FA2 regime. WIP (M3.3): GPU numerics are currently
// INCORRECT (computes zeros) pending OpPhi loop-carried SSA support; no test
// asserts bit-exactness yet.
//
// Implementation notes:
//   - K and V buffers contain f32 elements (avoids f16 scalar limitation in current HIR).
//   - Shared tiles hold f32 (workgroup[f32, 64]).
//   - head_dim is fixed at 32 for the correctness fixture (AT-1630: seq_len=64, head_dim=32).
//   - exp() is approximated via the exp2(x * log2e) builtin approximation (f32 arithmetic).
//   - For the test fixture, exp(x) is implemented as a first-order approximation.
//
// AT-1630 (M3.3 target): bit-exact within 1e-3 vs a CPU reference attention —
// NOT yet achieved; the current AT-1630 test is compile + spirv-val only.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>`.

@kernel
@workgroup(1, 1, 1)
@intent("correctness-first NON-streaming tiled attention (C1, NOT FA2 — AT-1630)")
@complexity(O(n))
fn tiled_attention(
    Q: readonly_buffer[f32],
    K: readonly_buffer[f32],
    V: readonly_buffer[f32],
    O: buffer[f32],
    seq_len: u32,
    head_dim: u32,
    inv_sqrt_d: f32
) -> void {
    // K and V rows staged into shared memory (one row at a time).
    // head_dim is at most 64 for the correctness fixture.
    shared k_tile: shared[f32, 64];    // K-vector (one row of K matrix)
    shared v_tile: shared[f32, 64];    // V-vector (one row of V matrix)

    let q_row: u32 = gid(0u32);        // Which query row this invocation handles.
    let q_base: u32 = q_row * head_dim;

    // ── Pass 1: Compute score row and find max for numerical stability ──────────
    // Initialize max to a very negative value (valid f32).
    let mut max_score: f32 = -1e9f32;

    for j in range(0u32, seq_len) {
        // Stage K[j] row into shared memory.
        // Each invocation (single-invocation workgroup for correctness) loads all elements.
        let k_base: u32 = j * head_dim;
        for d in range(0u32, head_dim) {
            k_tile[d] = K[k_base + d];
        }
        workgroup_barrier();

        // Dot product: score = dot(Q[q], k_tile) * inv_sqrt_d.
        let mut score: f32 = 0.0f32;
        for d in range(0u32, head_dim) {
            let q_val: f32 = Q[q_base + d];
            let k_val: f32 = k_tile[d];
            score = score + q_val * k_val;
        }
        score = score * inv_sqrt_d;

        // Update running max for numerical stability (correct softmax, NOT FA2 streaming).
        let is_larger: bool = score > max_score;
        if is_larger {
            max_score = score;
        }

        workgroup_barrier();
    }

    // ── Pass 2: Compute exp-normalized weights and accumulate output ────────────
    let mut denom: f32 = 0.0f32;

    // Compute denominator: sum of exp(score[j] - max_score).
    for j in range(0u32, seq_len) {
        let k_base: u32 = j * head_dim;
        for d in range(0u32, head_dim) {
            k_tile[d] = K[k_base + d];
        }
        workgroup_barrier();

        let mut score: f32 = 0.0f32;
        for d in range(0u32, head_dim) {
            let q_val: f32 = Q[q_base + d];
            let k_val: f32 = k_tile[d];
            score = score + q_val * k_val;
        }
        score = score * inv_sqrt_d;

        // exp(x) approximation: 1 + x + x^2/2 (Taylor; small |x-max| after subtraction).
        // For the correctness fixture, scores are small after max-subtraction.
        let x: f32 = score - max_score;
        let exp_x: f32 = 1.0f32 + x + x * x * 0.5f32;
        denom = denom + exp_x;

        workgroup_barrier();
    }

    // Normalize and accumulate output: O[q][d] = sum_j weight[j] * V[j][d].
    for d in range(0u32, head_dim) {
        let mut out_val: f32 = 0.0f32;

        for j in range(0u32, seq_len) {
            let k_base: u32 = j * head_dim;
            for dk in range(0u32, head_dim) {
                k_tile[dk] = K[k_base + dk];
            }
            let v_base: u32 = j * head_dim;
            for dv in range(0u32, head_dim) {
                v_tile[dv] = V[v_base + dv];
            }
            workgroup_barrier();

            let mut score: f32 = 0.0f32;
            for dk in range(0u32, head_dim) {
                let q_val: f32 = Q[q_base + dk];
                let k_val: f32 = k_tile[dk];
                score = score + q_val * k_val;
            }
            score = score * inv_sqrt_d;

            let x: f32 = score - max_score;
            let exp_x: f32 = 1.0f32 + x + x * x * 0.5f32;
            let weight: f32 = exp_x / denom;

            let v_val: f32 = v_tile[d];
            out_val = out_val + weight * v_val;

            workgroup_barrier();
        }

        let out_idx: u32 = q_base + d;
        O[out_idx] = out_val;
    }

    return;
}
