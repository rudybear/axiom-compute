// examples/q4km_matmul_rb_coopmat_f32acc_cached_ablate_passthrough.axc
//
// PROFILING INSTRUMENT — WRONG OUTPUT BY DESIGN — NOT A CORRECT/SHIPPABLE KERNEL — measures TFLOPS only
//
// M3.12 ABLATION DIAGNOSTIC — V-passthrough (the DECISIVE structure-vs-arithmetic fork,
// f32_to_f16-RETAINING).
//
// This is the M3.6 leader (q4km_matmul_rb_coopmat_f32acc_cached.axc) with ONLY the per-element
// A-dequant VALUE (cached.axc:240) replaced by an f32_to_f16-RETAINING pass-through of the loaded
// nibble:
//       a_tile[ei_a] = f32_to_f16(f32_from_u32(band(byte, 0x0F)))
// This KEEPS the packed-q u8 load + the FULL integer index-decode that addresses it + the nibble
// extract + the f32_from_u32 (ConvertUToF) + the f32_to_f16 CONVERT + the shared-A store + all 3
// barriers + the coopmat issue + the scale-cache FILL (held constant). It DROPS only the per-element
// dsc/dmm scale-cache READS (cached.axc:226-227) AND the FMul/FSub (cached.axc:240).
//
// WHY f32_to_f16-RETAINING (r2 Fix 5 + the optimistic builtin gap): `u32_to_f16_bits(...)` is NOT
// expressible — the ONLY f16-producing builtin is f32_to_f16 (q4_0.rs), there is NO u32->f16-bits
// bitcast, and shared[f16] writes are HARD-typechecked (SharedWriteTypeMismatch). So the convert
// MUST be retained; the pass-through still FORKS structure-vs-arithmetic when paired with
// V-structure-probe (which drops the load + the value's data dependency too).
//
// WHAT IT ISOLATES: the per-element scale-cache READS + FMul/FSub as a block, vs the residual
// {structure + u8 load + nibble-extract + ConvertUToF + the f32_to_f16 CONVERT}. DECISIVE on the
// re-anchored [42.86 <-> V-structure-probe] line:
//   * if V-passthrough jumps toward V-structure-probe => the per-element scale-reads+FMul/FSub are
//     the arithmetic tax (a feature target);
//   * if it STAYS near 42.86 => the residual is the {convert + load + ConvertUToF} chain OR the
//     structure — and since V-no-convert is DROPPED (no OpFConvert-free f16 sink), the pinpoint is
//     the {f32_to_f16-convert OR structure} two-component residual (both fold into the same
//     fused-dequant-coopmat-load, a narrowing).
//
// CAPABILITIES: byte-identical to the M3.6 leader (the substitute removes per-element Workgroup
// OpLoads + FMul/FSub and keeps the OpFConvert — no new op-class). shared_memory_bytes == 4096 (the
// fill is kept; the dsc/dmm arrays remain WRITTEN, read-unused).
//
// HONESTY: this variant computes WRONG output BY DESIGN (a_tile holds the un-scaled nibble). It is a
// DIAGNOSTIC-ONLY profiling instrument — NOT a correct kernel, NOT shippable, NO correctness gate.
// AT-2705 asserts the wrong-output marker above + that NO correctness-gated test references it.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>` (use lshr; k_block % 16 expressed as k_block - (k_block/16)*16).

@kernel
@workgroup(32, 1, 1)
@cooperative_matrix
@strategy { rb_m: ?[2], rb_n: ?[2], tile_k: ?[16], a_block_size: ?[512], b_block_size: ?[512] }
@intent("PROFILING INSTRUMENT (wrong output): M3.12 V-passthrough — keep load+convert+structure, drop scale-read+FMul/FSub")
@complexity(O(n))
fn q4km_matmul_rb_coopmat_f32acc_cached_ablate_passthrough(
    q: readonly_buffer[u8],
    x: readonly_buffer[f16],
    C: buffer[f32],
    M: u32,
    N: u32,
    K: u32,
    n_blocks_per_row: u32
) -> void {
    shared a_tile: shared[f16, ?a_block_size];
    shared b_tile: shared[f16, ?b_block_size];

    // M3.6 scale caches — KEPT (the fill is held constant; only the per-element READS are dropped).
    shared dsc_cache: shared[f32, 256];
    shared dmm_cache: shared[f32, 256];

    let block_col: u32 = gid(0u32) / 32u32;
    let block_row: u32 = gid(1u32);

    let lane: u32 = subgroup_invocation_id();

    let tile_row_0: u32 = block_row * 2u32;
    let tile_row_1: u32 = block_row * 2u32 + 1u32;
    let tile_col_0: u32 = block_col * 2u32;
    let tile_col_1: u32 = block_col * 2u32 + 1u32;

    let mut acc_00: matrix[f32, 16, 16, accumulator] = coopmat_zero();
    let mut acc_01: matrix[f32, 16, 16, accumulator] = coopmat_zero();
    let mut acc_10: matrix[f32, 16, 16, accumulator] = coopmat_zero();
    let mut acc_11: matrix[f32, 16, 16, accumulator] = coopmat_zero();

    let a_iters: u32 = ?a_block_size / 32u32;
    let b_iters: u32 = ?b_block_size / 32u32;

    let num_k_blocks: u32 = K / ?tile_k;

    for k_block in range(0u32, num_k_blocks) {
        let sb_idx: u32 = k_block / 16u32;

        // ── SCALE-CACHE FILL — VERBATIM M3.6 (HELD CONSTANT; structural, fires once per superblock) ──
        if k_block - sb_idx * 16u32 == 0u32 {
            for fi in range(0u32, 8u32) {
                let cache_i: u32 = fi * 32u32 + lane;
                let row_local: u32 = cache_i / 8u32;
                let is: u32 = cache_i - row_local * 8u32;
                let g_row: u32 = block_row * 32u32 + row_local;

                let base: u32 = g_row * n_blocks_per_row * 144u32 + sb_idx * 144u32;
                let d_bits: u32 = ptr_read_u16_zext(q, base);
                let dmin_bits: u32 = ptr_read_u16_zext(q, base + 2u32);
                let d: f32 = f16_bits_to_f32(d_bits);
                let dmin: f32 = f16_bits_to_f32(dmin_bits);
                let scales_base: u32 = base + 4u32;

                let mut sc: u32 = 0u32;
                let mut mm: u32 = 0u32;
                if is < 4u32 {
                    sc = band(ptr_read_u8_zext(q, scales_base + is), 63u32);
                    mm = band(ptr_read_u8_zext(q, scales_base + is + 4u32), 63u32);
                } else {
                    let lo4_sc: u32 = band(ptr_read_u8_zext(q, scales_base + is + 4u32), 0x0Fu32);
                    let hi2_sc: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is - 4u32), 6u32), 0x03u32);
                    sc = bor(lo4_sc, shl(hi2_sc, 4u32));
                    let lo4_m: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is + 4u32), 4u32), 0x0Fu32);
                    let hi2_m: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is), 6u32), 0x03u32);
                    mm = bor(lo4_m, shl(hi2_m, 4u32));
                }

                dsc_cache[cache_i] = d * f32_from_u32(sc);
                dmm_cache[cache_i] = dmin * f32_from_u32(mm);
            }
        }

        // RAW barrier (VERBATIM M3.6) — held constant.
        workgroup_barrier();

        // ── A staging: f32_to_f16-RETAINING nibble PASS-THROUGH (PROFILING INSTRUMENT — wrong output) ──
        //   KEEPS the full integer index-decode + the packed-q u8 load + the nibble extract +
        //   f32_from_u32 (ConvertUToF) + the f32_to_f16 CONVERT. DROPS the per-element dsc/dmm
        //   scale-cache READS + the FMul/FSub. a_tile holds the UN-SCALED nibble -> WRONG output.
        for a_iter in range(0u32, a_iters) {
            let ei_a: u32 = a_iter * 32u32 + lane;
            let a_row: u32 = ei_a / 16u32;
            let a_col: u32 = ei_a - a_row * 16u32;
            let g_k: u32 = k_block * ?tile_k + a_col;

            // Superblock-to-tile decode for this element's nibble (byte-identical M3.6) — KEPT so the
            // integer index-decode + the u8 load are held constant.
            let sb: u32 = g_k / 256u32;
            let wk: u32 = g_k - sb * 256u32;
            let chunk: u32 = wk / 64u32;
            let wc: u32 = wk - chunk * 64u32;
            let l: u32 = wc - (wc / 32u32) * 32u32;
            let is_hi: u32 = wc / 32u32;

            // Byte holding this element's nibble — VERBATIM M3.6 (the u8 load is KEPT).
            let base: u32 = (block_row * 32u32 + a_row) * n_blocks_per_row * 144u32 + sb * 144u32;
            let qs_base: u32 = base + 16u32;
            let byte: u32 = ptr_read_u8_zext(q, qs_base + chunk * 32u32 + l);
            let mut nib: u32 = band(byte, 0x0Fu32);
            if is_hi >= 1u32 {
                nib = band(lshr(byte, 4u32), 0x0Fu32);
            }

            // f32_to_f16-RETAINING pass-through: DROP the dsc/dmm scale-reads + the FMul/FSub; KEEP
            // the ConvertUToF + the f32_to_f16 convert. (WRONG output by design.)
            let w: f16 = f32_to_f16(f32_from_u32(nib));
            a_tile[ei_a] = w;
        }

        // ── Stage B (x) tile into b_tile — VERBATIM M3.6 ──────────────────────────
        for b_iter in range(0u32, b_iters) {
            let ei_b: u32 = b_iter * 32u32 + lane;
            let b_row: u32 = ei_b / 32u32;
            let b_col: u32 = ei_b - b_row * 32u32;
            let b_global_row: u32 = k_block * ?tile_k + b_row;
            let b_global_col: u32 = block_col * 32u32 + b_col;
            let b_global: u32 = b_global_row * N + b_global_col;
            b_tile[ei_b] = x[b_global];
        }

        workgroup_barrier();

        let a_mat_0: matrix[f16, 16, 16, a] = coopmat_load(a_tile, 0u32, 16u32);
        let a_mat_1: matrix[f16, 16, 16, a] = coopmat_load(a_tile, 256u32, 16u32);

        let b_mat_0: matrix[f16, 16, 16, b] = coopmat_load(b_tile, 0u32, 32u32);
        let b_mat_1: matrix[f16, 16, 16, b] = coopmat_load(b_tile, 16u32, 32u32);

        acc_00 = coopmat_mul_add(a_mat_0, b_mat_0, acc_00);
        acc_01 = coopmat_mul_add(a_mat_0, b_mat_1, acc_01);
        acc_10 = coopmat_mul_add(a_mat_1, b_mat_0, acc_10);
        acc_11 = coopmat_mul_add(a_mat_1, b_mat_1, acc_11);

        workgroup_barrier();
    }

    let c_base_00: u32 = (tile_row_0 * 16u32) * N + (tile_col_0 * 16u32);
    let c_base_01: u32 = (tile_row_0 * 16u32) * N + (tile_col_1 * 16u32);
    let c_base_10: u32 = (tile_row_1 * 16u32) * N + (tile_col_0 * 16u32);
    let c_base_11: u32 = (tile_row_1 * 16u32) * N + (tile_col_1 * 16u32);

    coopmat_store(acc_00, C, c_base_00, N);
    coopmat_store(acc_01, C, c_base_01, N);
    coopmat_store(acc_10, C, c_base_10, N);
    coopmat_store(acc_11, C, c_base_11, N);

    return;
}
