// q4km_dequant_matmul.axc — M3.1: multi-row Q4_K_M dequant + matmul (NO coopmat).
//
// Each invocation computes ONE output element y[row * n_cols + col] by
// dequantizing the weight row and dot-producting with the input column.
//
// Layout (per HN-11 — PINNED):
//   q: weight matrix as n_rows consecutive weight-rows, row-major.
//      weight-row `row` = bytes [row * n_blocks_per_row * 144 .. (row+1) * n_blocks_per_row * 144]
//      Each 144-byte block is a Q4_K_M superblock (same layout as q4km_dequant_matvec.axc).
//   x: dense input matrix, column-of-output-major:
//      x[k * n_cols + col] = k-th dequantized-weight-index input for output column col
//      k in 0 .. n_blocks_per_row * 256
//   y: output, row-major: y[row * n_cols + col]
//
// For the 256x256 fixture: n_rows=256, n_cols=256, n_blocks_per_row=1
// (one 144-byte superblock per weight-row, 256 weights = 256 contraction elements).
//
// Bit-exact vs q4km_dequant_matmul_cpu for the 256x256 fixture (AT-1520).
// NOT #[ignore] — runs on Lavapipe AND NVIDIA.

@kernel
@workgroup(64, 1, 1)
@intent("Multi-row Q4_K_M dequant + matmul: y[row,col] = sum_k dequant(q[row,k]) * x[k,col]")
@complexity(O(n))
@precondition(true)
fn q4km_dequant_matmul(
    q: readonly_buffer[u8],
    x: readonly_buffer[f32],
    y: buffer[f32],
    n_rows: u32,
    n_cols: u32,
    n_blocks_per_row: u32,
) -> void {
    let i: u32 = gid(0u32);
    let total_outputs: u32 = n_rows * n_cols;
    if i >= total_outputs { return; }
    let row: u32 = i / n_cols;
    let col: u32 = i - row * n_cols;
    let mut sum: f32 = 0.0f32;
    // Walk all superblocks for this weight row.
    for sb in range(0u32, n_blocks_per_row) {
        // Byte offset of superblock sb in weight-row `row`.
        let base: u32 = row * n_blocks_per_row * 144u32 + sb * 144u32;
        // Load super-scale d and super-min dmin (f16, bytes [base..base+4]).
        let d_bits: u32 = ptr_read_u16_zext(q, base);
        let dmin_bits: u32 = ptr_read_u16_zext(q, base + 2u32);
        let d: f32 = f16_bits_to_f32(d_bits);
        let dmin: f32 = f16_bits_to_f32(dmin_bits);
        let scales_base: u32 = base + 4u32;
        let qs_base: u32 = base + 16u32;
        // Four chunks of 64 elements each (4 * 64 = 256 per superblock).
        for chunk in range(0u32, 4u32) {
            let is0: u32 = chunk * 2u32;
            let is1: u32 = is0 + 1u32;
            // Inline get_scale_min_k4 for sub-block is0.
            let mut sc0: u32 = 0u32;
            let mut m0: u32 = 0u32;
            if is0 < 4u32 {
                sc0 = band(ptr_read_u8_zext(q, scales_base + is0), 63u32);
                m0  = band(ptr_read_u8_zext(q, scales_base + is0 + 4u32), 63u32);
            } else {
                let lo4_sc: u32 = band(ptr_read_u8_zext(q, scales_base + is0 + 4u32), 0x0Fu32);
                let hi2_sc: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is0 - 4u32), 6u32), 0x03u32);
                sc0 = bor(lo4_sc, shl(hi2_sc, 4u32));
                let lo4_m: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is0 + 4u32), 4u32), 0x0Fu32);
                let hi2_m: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is0), 6u32), 0x03u32);
                m0 = bor(lo4_m, shl(hi2_m, 4u32));
            }
            // Inline get_scale_min_k4 for sub-block is1.
            let mut sc1: u32 = 0u32;
            let mut m1v: u32 = 0u32;
            if is1 < 4u32 {
                sc1 = band(ptr_read_u8_zext(q, scales_base + is1), 63u32);
                m1v = band(ptr_read_u8_zext(q, scales_base + is1 + 4u32), 63u32);
            } else {
                let lo4_sc1: u32 = band(ptr_read_u8_zext(q, scales_base + is1 + 4u32), 0x0Fu32);
                let hi2_sc1: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is1 - 4u32), 6u32), 0x03u32);
                sc1 = bor(lo4_sc1, shl(hi2_sc1, 4u32));
                let lo4_m1: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is1 + 4u32), 4u32), 0x0Fu32);
                let hi2_m1: u32 = band(lshr(ptr_read_u8_zext(q, scales_base + is1), 6u32), 0x03u32);
                m1v = bor(lo4_m1, shl(hi2_m1, 4u32));
            }
            // Per-sub-block scale and min coefficients.
            let d1:  f32 = d    * f32_from_u32(sc0);
            let m1f: f32 = dmin * f32_from_u32(m0);
            let d2:  f32 = d    * f32_from_u32(sc1);
            let m2f: f32 = dmin * f32_from_u32(m1v);
            // Inner 32-iteration loop: each byte has lo nibble (is0) and hi nibble (is1).
            // x-index: x[k * n_cols + col] where k = sb*256 + chunk*64 + element.
            for l in range(0u32, 32u32) {
                let byte_off: u32 = qs_base + chunk * 32u32 + l;
                let byte: u32 = ptr_read_u8_zext(q, byte_off);
                let lo_nib: u32 = band(byte, 0x0Fu32);
                let hi_nib: u32 = band(lshr(byte, 4u32), 0x0Fu32);
                let lo_f: f32 = d1 * f32_from_u32(lo_nib) - m1f;
                let hi_f: f32 = d2 * f32_from_u32(hi_nib) - m2f;
                // k indices for x access (column-of-output-major layout).
                let k_lo: u32 = sb * 256u32 + chunk * 64u32 + l;
                let k_hi: u32 = sb * 256u32 + chunk * 64u32 + 32u32 + l;
                let x_lo: f32 = x[k_lo * n_cols + col];
                let x_hi: f32 = x[k_hi * n_cols + col];
                sum = sum + lo_f * x_lo + hi_f * x_hi;
            }
        }
    }
    y[row * n_cols + col] = sum;
    return;
}
