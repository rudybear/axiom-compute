// examples/flash_attention_coopmat_pv.axc — M3.2c-PV: coopmat-accelerated P·V FlashAttention-2.
//
// Carries M3.2c-perf (flash_attention_coopmat.axc): S = Q·Kᵀ as a cooperative_matrix
// (tensor-core) matmul into shared, scalar online softmax, scalar per-row rescale-add into
// acc-in-shared. The NEW step is the SECOND matmul PV = P·V, ALSO on tensor cores, the SAME
// "coopmat-into-shared + scalar-combine" pattern as QKᵀ. PURE SOURCE — ZERO codegen change.
//
// THE TWO MATMULS, BOTH ON TENSOR CORES (the M3.2c-PV completion):
//   1. S = Q·Kᵀ : coopmat (carried from M3.2c-perf) → s_tile_sh (f32).
//   2. PV = P·V : coopmat (NEW) → pv_sh (f32), then a SCALAR per-row rescale-add folds it into
//      acc-in-shared. acc stays in shared (NOT a coopmat) → the per-row diagonal-scale crux is
//      NOT re-introduced (Option C stays DEFERRED). coopmat_mul_add is A·B+C only.
//
// THE ONE GENUINE SOURCE CHANGE vs M3.2c-perf: the coopmat A-operand is f16. The M3.2c-perf
// softmax overwrote P in place into the f32 s_tile_sh, which CANNOT be a coopmat A-load. So the
// softmax now writes P (= exp(S·inv_sqrt_d − m_new)) as f16 into a SEPARATE tile p_sh, and V
// narrows to f16 (the coopmat B-operand) — funding the shared budget back under 16384.
//
// ── Tiling + dispatch (UNCHANGED from M3.2c-perf) ──────────────────────────────────────────
//   TILE_Q = TILE_K = 16, head_dim = 64 (= 4 coopmat K-blocks of 16). @workgroup(32,1,1) = one
//   subgroup. Dispatch (seq_len/16, 1, 1) workgroups: q_tile = gid(0)/32; lane =
//   subgroup_invocation_id(). seq_len%16==0 and head_dim==64 are host-preflight-enforced.
//
// ── Shared layout (head_dim=64, TILE_Q=TILE_K=16) — 16064 B total < 16384 portable floor ───
//   q_tile_sh: shared[f16, 16*64] = 1024 f16 = 2048 B   (Q tile, staged ONCE — the FA2 win)
//   k_tile_sh: shared[f16, 64*16] = 1024 f16 = 2048 B   (K block TRANSPOSED [d_full][key], Kᵀ)
//   v_tile_sh: shared[f16, 16*64] = 1024 f16 = 2048 B   (V block, NOW f16 — coopmat B-operand)
//   s_tile_sh: shared[f32, 16*16] =  256 f32 = 1024 B   (coopmat S=QKᵀ result; read by softmax)
//   p_sh:      shared[f16, 16*16] =  256 f16 =  512 B   (P tile NEW — f16, coopmat A-operand)
//   pv_sh:     shared[f32, 16*64] = 1024 f32 = 4096 B   (coopmat PV=P·V result NEW)
//   acc_sh:    shared[f32, 16*64] = 1024 f32 = 4096 B   (rescaled output accumulator — the crux)
//   m_sh:      shared[f32, 16]    =   16 f32 =   64 B   (per-row running max)
//   l_sh:      shared[f32, 16]    =   16 f32 =   64 B   (per-row running denom)
//   corr_sh:   shared[f32, 16]    =   16 f32 =   64 B   (per-row block correction; cross-lane)
//   TOTAL = 16064 B (= 13504 M3.2c-perf + p_sh 512 + pv_sh 4096 − v f32→f16 saving 2048).
//
// ── Lane partitions (R1, DISJOINT + TOTAL — carried from M3.2c-perf) ────────────────────────
//   softmax phase (under `if lane < 16`): lane L owns row L; lanes 16..31 idle. Lane L is the
//     SOLE writer of m_sh[L]/l_sh[L]/corr_sh[L] and of p_sh[L*16 .. L*16+15] (writes P f16 into
//     p_sh INSTEAD of overwriting s_tile_sh — the only R1 change vs M3.2c-perf).
//   coopmat P·V phase (warp-collective, all 32 lanes): the coopmat ops are subgroup-collective.
//   rescale-add / zero-init / finalize phase (ALL 32 lanes): lane L owns cells {c = L + 32*i,
//     i in 0..32}; r = c/64, d = c%64. UNCHANGED (now READS pv_sh[c] instead of computing Σ P·V).
//
// ── The 5 barriers (R2, ALL at conditional_depth==0 — NONE inside the lane<16 branch) ───────
//   (1) post K/V/(first-block Q) staging → before coopmat loads             (RAW)
//   (2) after the warp-collective coopmat S-store → before scalar S-read    (RAW)
//   (P) after BOTH p_sh AND corr_sh written → before the warp-collective coopmat P-load (reads
//         p_sh) AND the rescale's corr_sh read. Cross-lane: p_sh written by lane r<16, read by
//         all 32 lanes; corr_sh[r] written by lane r, read by cell-owner lane c%32.  (RAW)
//   (PV) NEW — after the warp-collective PV→pv_sh store → before the scalar rescale reads pv_sh.
//         A miss = reading a partially-stored PV = silent wrong.            (RAW)
//   (4) WAR end-of-body → before the next block overwrites k/v/s/p/pv/corr shared.  (WAR)
//
// ── s_acc + pv_acc BOTH iteration-local (R3 — NO coopmat OpPhi) ─────────────────────────────
//   s_acc (QKᵀ) AND every pv_acc_ds (the 4 PV sub-block accumulators) are DECLARED INSIDE the
//   K/V-block loop body (fresh coopmat_zero() per iteration, the mul_adds UNROLLED at the
//   K/V-body top level — NOT nested loops, NOT pre-loop declared) → no pre-loop SSA id → NOT
//   loop-carried → EXACTLY 0 coopmat OpPhi (AT-2211). Both share the ONE 16×16×16 f16/f16/f32
//   coopmat shape → 3 coopmat types total. Only acc_sh/m_sh/l_sh (SHARED) loop-carry.
//
// Anti-pattern #2: explicit `return;`.   Anti-pattern #8: no `>>` (none used here).

@kernel
@workgroup(32, 1, 1)
@cooperative_matrix
@intent("coopmat S=QKᵀ AND P·V FlashAttention-2: 16-row query tile, scalar softmax + acc-in-shared (AT-2210..2216)")
@complexity(O(n))
fn flash_attention_coopmat_pv(
    Q: readonly_buffer[f32],
    K: readonly_buffer[f32],
    V: readonly_buffer[f32],
    O: buffer[f32],
    seq_len: u32,
    head_dim: u32,
    inv_sqrt_d: f32
) -> void {
    // Shared layout (see header). head_dim=64, TILE_Q=TILE_K=16 (host-preflight-enforced).
    shared q_tile_sh: shared[f16, 1024];   // Q tile [16][64], row-major (f16 for coopmat A)
    shared k_tile_sh: shared[f16, 1024];   // K block TRANSPOSED [64][16] (d_full,key) → Kᵀ
    shared v_tile_sh: shared[f16, 1024];   // V block [16][64], row-major (f16 for coopmat B)
    shared s_tile_sh: shared[f32, 256];    // S=QKᵀ [16][16] (coopmat store dest; read by softmax)
    shared p_sh: shared[f16, 256];         // P tile [16][16] (NEW — f16, coopmat A-operand)
    shared pv_sh: shared[f32, 1024];       // PV=P·V [16][64] (NEW — coopmat store dest)
    shared acc_sh: shared[f32, 1024];      // output accumulator [16][64] (the crux — in shared)
    shared m_sh: shared[f32, 16];          // per-row running max
    shared l_sh: shared[f32, 16];          // per-row running denom
    shared corr_sh: shared[f32, 16];       // per-row block correction (cross-lane)

    // Which 16-row query tile this workgroup handles (ASYMMETRIC gid(0)/32 divide).
    let q_tile: u32 = gid(0u32) / 32u32;
    let lane: u32 = subgroup_invocation_id();

    // Global row base of this query tile.
    let q_tile_row0: u32 = q_tile * 16u32;

    // ── Stage Q tile ONCE (reused across all K/V blocks — the FA2 win) ───────────────────
    // q_tile_sh[16*64=1024] = Q[(q_tile_row0 + r)*head_dim + d], r=ei/64, d=ei%64.
    for q_it in range(0u32, 32u32) {
        let ei: u32 = q_it * 32u32 + lane;
        let r: u32 = ei / 64u32;
        let d: u32 = ei - r * 64u32;
        let g_row: u32 = q_tile_row0 + r;
        q_tile_sh[ei] = f32_to_f16(Q[g_row * head_dim + d]);
    }

    // ── Zero-init acc_sh + per-row state (R1 cell partition; m/l set by lane<16) ──────────
    for z_it in range(0u32, 32u32) {
        let c: u32 = z_it * 32u32 + lane;
        acc_sh[c] = 0.0f32;
    }
    if lane < 16u32 {
        m_sh[lane] = -1e9f32;   // running max init (j==0 guard forces correction=0 first)
        l_sh[lane] = 0.0f32;    // running denom
    }
    workgroup_barrier();

    // Number of K/V blocks streamed (seq_len / TILE_K). seq_len%16==0 host-enforced.
    let num_kv_blocks: u32 = seq_len / 16u32;

    // ── The K/V-block loop (TILE_K=16 keys per block) ─────────────────────────────────────
    for j in range(0u32, num_kv_blocks) {
        let kv_row0: u32 = j * 16u32;     // global key-row base of this block

        // ── Stage K block TRANSPOSED into k_tile_sh [d_full][key] ────────────────────────
        // k_tile_sh[d*16 + key] = K[(kv_row0 + key)*head_dim + d], d in 0..64, key in 0..16.
        for k_it in range(0u32, 32u32) {
            let ei_k: u32 = k_it * 32u32 + lane;
            let d_full: u32 = ei_k / 16u32;
            let key: u32 = ei_k - d_full * 16u32;
            let g_krow: u32 = kv_row0 + key;
            k_tile_sh[ei_k] = f32_to_f16(K[g_krow * head_dim + d_full]);
        }

        // ── Stage V block [key][d] into v_tile_sh (NOW f16, coopmat B-operand) ────────────
        // v_tile_sh[key*64 + d] = f32_to_f16(V[(kv_row0 + key)*head_dim + d]). ei = it*32+lane.
        for v_it in range(0u32, 32u32) {
            let ei_v: u32 = v_it * 32u32 + lane;
            let vkey: u32 = ei_v / 64u32;
            let vd: u32 = ei_v - vkey * 64u32;
            let g_vrow: u32 = kv_row0 + vkey;
            v_tile_sh[ei_v] = f32_to_f16(V[g_vrow * head_dim + vd]);
        }

        // BARRIER (1): staging writes → coopmat loads (RAW). Depth 0.
        workgroup_barrier();

        // ── coopmat S = Q·Kᵀ (4 head-dim sub-blocks, UNROLLED at top level; s_acc fresh) ─
        // A sub-block dk: q_tile_sh[16][64], the dk-th 16-wide column slice (offset dk*16,
        //   stride 64). B sub-block dk: k_tile_sh[64][16], the dk-th 16-row slice (offset
        //   dk*256, stride 16) = Kᵀ. s_acc += A_dk · B_dk for dk = 0..3.
        let mut s_acc: matrix[f32, 16, 16, accumulator] = coopmat_zero();

        let qa0: matrix[f16, 16, 16, a] = coopmat_load(q_tile_sh, 0u32, 64u32);
        let qa1: matrix[f16, 16, 16, a] = coopmat_load(q_tile_sh, 16u32, 64u32);
        let qa2: matrix[f16, 16, 16, a] = coopmat_load(q_tile_sh, 32u32, 64u32);
        let qa3: matrix[f16, 16, 16, a] = coopmat_load(q_tile_sh, 48u32, 64u32);

        let kb0: matrix[f16, 16, 16, b] = coopmat_load(k_tile_sh, 0u32, 16u32);
        let kb1: matrix[f16, 16, 16, b] = coopmat_load(k_tile_sh, 256u32, 16u32);
        let kb2: matrix[f16, 16, 16, b] = coopmat_load(k_tile_sh, 512u32, 16u32);
        let kb3: matrix[f16, 16, 16, b] = coopmat_load(k_tile_sh, 768u32, 16u32);

        s_acc = coopmat_mul_add(qa0, kb0, s_acc);
        s_acc = coopmat_mul_add(qa1, kb1, s_acc);
        s_acc = coopmat_mul_add(qa2, kb2, s_acc);
        s_acc = coopmat_mul_add(qa3, kb3, s_acc);

        // Store S → shared (warp-collective, all 32 lanes). Row width = TILE_K = 16.
        coopmat_store(s_acc, s_tile_sh, 0u32, 16u32);

        // BARRIER (2): collective S-store → scalar S-read (RAW). Depth 0, BEFORE the branch.
        workgroup_barrier();

        // ── Scalar online-softmax over the shared S tile (R1: lane L owns row L, L<16) ────
        // CHANGED vs M3.2c-perf: P is written as f16 into a SEPARATE p_sh (the coopmat
        // A-operand needs f16 RowMajor), NOT back into the f32 s_tile_sh.
        if lane < 16u32 {
            let r: u32 = lane;
            let r_base: u32 = r * 16u32;
            let m_i: f32 = m_sh[r];
            let l_i: f32 = l_sh[r];

            // rowmax: m_new = max(m_i, max_t S[r][t]*inv_sqrt_d).
            let mut m_new: f32 = m_i;
            for t0 in range(0u32, 16u32) {
                let s_t: f32 = s_tile_sh[r_base + t0] * inv_sqrt_d;
                let bigger: bool = s_t > m_new;
                if bigger {
                    m_new = s_t;
                }
            }

            // correction = exp(m_i - m_new), EXCEPT j==0 where FORCED to 0 (no prior mass).
            let cx: f32 = m_i - m_new;
            let mut correction: f32 = exp(cx);
            let is_first: bool = j == 0u32;
            if is_first {
                correction = 0.0f32;
            }
            corr_sh[r] = correction;    // CROSS-LANE: read by cell-owner lane c%32 in the rescale

            // P = exp(S·inv_sqrt_d − m_new) → f16 into p_sh (NOT back into s_tile_sh); rowsum.
            let mut psum: f32 = 0.0f32;
            for t1 in range(0u32, 16u32) {
                let px: f32 = s_tile_sh[r_base + t1] * inv_sqrt_d - m_new;
                let p: f32 = exp(px);
                p_sh[r_base + t1] = f32_to_f16(p);
                psum = psum + p;
            }

            l_sh[r] = l_i * correction + psum;
            m_sh[r] = m_new;
        }

        // BARRIER (P): p_sh AND corr_sh fully written → warp-collective coopmat P-load reads
        // p_sh, and the rescale reads corr_sh. Depth 0, AFTER the lane<16 branch closes (a
        // barrier inside the branch would be a BarrierInDivergentContext hard error).
        workgroup_barrier();

        // ── coopmat PV = P·V (4 head-dim output sub-blocks; P loaded ONCE, each pv_acc fresh) ─
        // P is [16][16] (TILE_Q × TILE_K), V is [16][64] (TILE_K × head_dim). PV = P·V is
        // [16][64] = 4 output sub-blocks (16×16). The contraction is over TILE_K=16 = exactly
        // ONE coopmat K-block → 1 mul_add per output sub-block (4 total).
        //   pa: A-operand from p_sh[16][16], row-major (offset 0, stride 16).
        //   vb_ds: B-operand = V[16][64]'s ds-th 16-wide column slice (offset ds*16, stride 64).
        //   pv_acc_ds: FRESH coopmat_zero() per sub-block (iteration-local → no phi).
        //   store: pv_sh[16][64]'s ds-th 16-wide column slice (offset ds*16, stride 64).
        let pa: matrix[f16, 16, 16, a] = coopmat_load(p_sh, 0u32, 16u32);

        let vb0: matrix[f16, 16, 16, b] = coopmat_load(v_tile_sh, 0u32, 64u32);
        let vb1: matrix[f16, 16, 16, b] = coopmat_load(v_tile_sh, 16u32, 64u32);
        let vb2: matrix[f16, 16, 16, b] = coopmat_load(v_tile_sh, 32u32, 64u32);
        let vb3: matrix[f16, 16, 16, b] = coopmat_load(v_tile_sh, 48u32, 64u32);

        let mut pv_acc0: matrix[f32, 16, 16, accumulator] = coopmat_zero();
        pv_acc0 = coopmat_mul_add(pa, vb0, pv_acc0);
        coopmat_store(pv_acc0, pv_sh, 0u32, 64u32);

        let mut pv_acc1: matrix[f32, 16, 16, accumulator] = coopmat_zero();
        pv_acc1 = coopmat_mul_add(pa, vb1, pv_acc1);
        coopmat_store(pv_acc1, pv_sh, 16u32, 64u32);

        let mut pv_acc2: matrix[f32, 16, 16, accumulator] = coopmat_zero();
        pv_acc2 = coopmat_mul_add(pa, vb2, pv_acc2);
        coopmat_store(pv_acc2, pv_sh, 32u32, 64u32);

        let mut pv_acc3: matrix[f32, 16, 16, accumulator] = coopmat_zero();
        pv_acc3 = coopmat_mul_add(pa, vb3, pv_acc3);
        coopmat_store(pv_acc3, pv_sh, 48u32, 64u32);

        // BARRIER (PV): warp-collective PV→pv_sh store → scalar rescale reads pv_sh. Depth 0.
        workgroup_barrier();

        // ── Scalar rescale-add into acc-in-shared (UNCHANGED mechanism; reads pv_sh) ──────
        // acc_sh[c] = acc_sh[c]*corr_sh[r] + pv_sh[c], r=c/64. The per-row diagonal rescale
        // stays SCALAR (acc stays in shared — the crux is NOT re-introduced).
        for pv_it in range(0u32, 32u32) {
            let c: u32 = pv_it * 32u32 + lane;
            let rr: u32 = c / 64u32;
            let corr: f32 = corr_sh[rr];   // cross-lane read (written by lane rr; ordered by BARRIER(P))
            acc_sh[c] = acc_sh[c] * corr + pv_sh[c];
        }

        // BARRIER (4): WAR — rescale reads of pv/corr → next block overwrites k/v/s/p/pv/corr.
        workgroup_barrier();
    }

    // ── Finalize: O[r][d] = acc_sh[c] / l_sh[r] (R1 cell partition; same as the rescale) ──
    for f_it in range(0u32, 32u32) {
        let c: u32 = f_it * 32u32 + lane;
        let rr: u32 = c / 64u32;
        let dd: u32 = c - rr * 64u32;
        let g_orow: u32 = q_tile_row0 + rr;
        let out_idx: u32 = g_orow * head_dim + dd;
        O[out_idx] = acc_sh[c] / l_sh[rr];
    }

    return;
}
