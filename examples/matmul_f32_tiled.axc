// matmul_f32_tiled.axc — M3.1.5: NAIVE un-tiled scalar f32 GEMM (HARNESS VALIDATION ONLY).
//
// Computes C[row, col] = sum_k A[row, k] * B[k, col] for ONE (row, col) per invocation.
// Row-major layout for all three matrices. Uncoalesced B access (B[ki*n+col] strides).
//
// THIS IS NOT AN OPTIMIZED MATMUL. It is used only for harness validation:
//   - naive_gemm_harness_validation bench: measures the resident-timing harness,
//     labeled "NAIVE un-tiled scalar f32 GEMM — harness validation only, NOT an
//     optimized matmul; expect low single-digit % of cuBLAS".
//   - AT-1576: compile_source_with_meta works without @strategy holes.
//   - AT-1581: the bench printed string MUST contain "NAIVE" and "harness validation".
//
// The former @strategy { tile_m: ?[1,2,4], tile_n: ?[1,2,4] } holes were REMOVED
// because they were INERT — never referenced in the kernel body. Pinning tile_m=1/2/4
// produced byte-identical SPIR-V. The holes are now gone; this file compiles via
// compile_source_with_meta with no assignments.
//
// Register/workgroup tiling (a real tile_m×tile_n block per invocation, using
// shared[T,N] workgroup memory, FG.6) is DEFERRED TO M3.2. The former tile holes
// would have needed to be wired into the body (separate accumulation loops, different
// dispatch dimensions) to have any effect — that is M3.2 scope.
//
// Bit-exact vs matmul_f32_cpu for small cases; relative tolerance 1e-3 via f32
// scalar accumulation holds for 4096x4096.

@kernel
@workgroup(64, 1, 1)
@intent("NAIVE un-tiled scalar f32 GEMM C = A*B; one (row,col) per invocation; harness validation only — NOT an optimized matmul")
@complexity(O(n))
@precondition(true)
fn matmul_f32_tiled(
    a_buf: readonly_buffer[f32],
    b_buf: readonly_buffer[f32],
    c_buf: buffer[f32],
    m: u32,
    n: u32,
    k: u32,
) -> void {
    let i: u32 = gid(0u32);
    let total: u32 = m * n;
    if i >= total { return; }
    let row: u32 = i / n;
    let col: u32 = i - row * n;
    let mut acc: f32 = 0.0f32;
    for ki in range(0u32, k) {
        let a_val: f32 = a_buf[row * k + ki];
        let b_val: f32 = b_buf[ki * n + col];
        acc = acc + a_val * b_val;
    }
    c_buf[row * n + col] = acc;
    return;
}
