// q6k_dequant_matmul.axc — M3.14a: multi-row Q6_K dequant + matmul (NO coopmat).
//
// Mirror of examples/q4km_dequant_matmul.axc (M3.1). Each invocation computes ONE output
// element y[row * n_cols + col] by dequantizing the weight row and dot-producting with the
// input column.
//
// Layout (block_q6_K, 210 bytes / 256 weights — FROZEN §3.1, NOTE the field order differs
// from Q4_K_M: `d` is the LAST 2 bytes, and there is NO `dmin`):
//   q: weight matrix as n_rows consecutive weight-rows, row-major.
//      weight-row `row` = bytes [row * n_blocks_per_row * 210 .. (row+1) * n_blocks_per_row * 210]
//      Each 210-byte superblock:
//        [0..128)   ql[128]    low 4 bits of each weight   (QK_K/2 = 128)
//        [128..192) qh[64]     high 2 bits of each weight  (QK_K/4 = 64)
//        [192..208) scales[16] int8 SIGNED per-16-element scales (QK_K/16 = 16)
//        [208..210) d          ggml_half super-scale (f16 LE) -- LAST, no dmin.
//   x: dense input matrix, column-of-output-major: x[k * n_cols + col], k in 0..n_blocks_per_row*256.
//   y: output, row-major: y[row * n_cols + col].
//
// DEQUANT (ggml, byte-exact). The superblock is processed in 2 halves of 128 weights; within
// each half h in {0,1}, for l in 0..32, is = l/16:
//   q1 = ((ql[64h+l]      & 0x0F) | (((qh[32h+l] >> 0) & 3) << 4)) - 32
//   q2 = ((ql[64h+l + 32] & 0x0F) | (((qh[32h+l] >> 2) & 3) << 4)) - 32
//   q3 = ((ql[64h+l]      >>  4)  | (((qh[32h+l] >> 4) & 3) << 4)) - 32
//   q4 = ((ql[64h+l + 32] >>  4)  | (((qh[32h+l] >> 6) & 3) << 4)) - 32
//   y[128h+l+ 0] = d * sc[8h+is+0] * q1        <- sc index for q1 (§3.1 line 1)
//   y[128h+l+32] = d * sc[8h+is+2] * q2        <- sc index for q2 (§3.1 line 2)
//   y[128h+l+64] = d * sc[8h+is+4] * q3        <- sc index for q3 (§3.1 line 3)
//   y[128h+l+96] = d * sc[8h+is+6] * q4        <- sc index for q4 (§3.1 line 4)
// `sc[.]` is the SIGNED int8 scale; q* in [-32,31]; sc in [-128,127].
//
// SIGNED HANDLING — pure source, NO new builtin (the one novel technique, §4.1/§7):
// AXIOM exposes no signed-int read/convert builtin, so the int8 scale is reconstructed from a
// zero-extended u8 read in f32:
//   sc_f = f32_from_u32(sc_u); if sc_u >= 128 { sc_f = sc_f - 256.0; }   // now [-128,127] as f32
// and the (q-32) bias is computed directly in f32 (q_u in 0..63 is f32-exact):
//   q_f = f32_from_u32(q_u) - 32.0
// The whole path is existing builtins (ptr_read_u8_zext, f32_from_u32, band, bor, shl, lshr) +
// f32 arithmetic + an `if` — ZERO new SPIR-V capability/extension vs q4km_dequant_matmul.axc.
//
// Kernel-matching associativity (FROZEN, matches q6k_oracle::q6k_dequant_matmul_f32_cpu):
// weight = (d * sc_f) * q_f, and the accumulation is left-to-right
// `sum = sum + w1*x1 + w2*x2 + w3*x3 + w4*x4` — so max_diff==0 holds by construction on an
// exact-integer fixture (AT-2814).
//
// Bit-exact vs q6k_oracle::q6k_dequant_matmul_f32_cpu for a K=256 fixture (AT-2814).
// NOT #[ignore] — runs on Lavapipe AND NVIDIA.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>` (use shr/lshr for shifts); l/16 uses integer `/` (division, not a
//   bit-shift operator, so it is NOT anti-pattern #8 — `is = l / 16u32` is ordinary int division).

@kernel
@workgroup(64, 1, 1)
@intent("Multi-row Q6_K dequant + matmul: y[row,col] = sum_k dequant_q6k(q[row,k]) * x[k,col]")
@complexity(O(n))
@precondition(true)
fn q6k_dequant_matmul(
    q: readonly_buffer[u8],
    x: readonly_buffer[f32],
    y: buffer[f32],
    n_rows: u32,
    n_cols: u32,
    n_blocks_per_row: u32,
) -> void {
    let i: u32 = gid(0u32);
    let total_outputs: u32 = n_rows * n_cols;
    if i >= total_outputs { return; }
    let row: u32 = i / n_cols;
    let col: u32 = i - row * n_cols;
    let mut sum: f32 = 0.0f32;

    // Walk all superblocks for this weight row.
    for sb in range(0u32, n_blocks_per_row) {
        // Byte offset of superblock sb in weight-row `row` (210 bytes/superblock — NOT 144).
        let base: u32 = row * n_blocks_per_row * 210u32 + sb * 210u32;
        let ql_base: u32 = base;           // [0..128)
        let qh_base: u32 = base + 128u32;  // [128..192)
        let sc_base: u32 = base + 192u32;  // [192..208)
        // d is the LAST 2 bytes (offset 208) — field order differs from Q4_K_M; NO dmin.
        let d_bits: u32 = ptr_read_u16_zext(q, base + 208u32);
        let d: f32 = f16_bits_to_f32(d_bits);

        for h in range(0u32, 2u32) {
            for l in range(0u32, 32u32) {
                // is = l/16 selects which of the two scale-pairs (§3.1) this l falls into.
                let is: u32 = l / 16u32;

                let ql1: u32 = ptr_read_u8_zext(q, ql_base + 64u32 * h + l);
                let ql2: u32 = ptr_read_u8_zext(q, ql_base + 64u32 * h + l + 32u32);
                let qh_byte: u32 = ptr_read_u8_zext(q, qh_base + 32u32 * h + l);

                // q1..q4 reassembly per §3.1 (low 4 bits from ql, high 2 bits from a qh
                // bit-pair), the -32 bias applied in f32 below.
                let bits01: u32 = band(qh_byte, 3u32);
                let bits23: u32 = band(lshr(qh_byte, 2u32), 3u32);
                let bits45: u32 = band(lshr(qh_byte, 4u32), 3u32);
                let bits67: u32 = band(lshr(qh_byte, 6u32), 3u32);

                let q1_u: u32 = bor(band(ql1, 0x0Fu32), shl(bits01, 4u32));
                let q2_u: u32 = bor(band(ql2, 0x0Fu32), shl(bits23, 4u32));
                let q3_u: u32 = bor(lshr(ql1, 4u32), shl(bits45, 4u32));
                let q4_u: u32 = bor(lshr(ql2, 4u32), shl(bits67, 4u32));

                let q1_f: f32 = f32_from_u32(q1_u) - 32.0f32;
                let q2_f: f32 = f32_from_u32(q2_u) - 32.0f32;
                let q3_f: f32 = f32_from_u32(q3_u) - 32.0f32;
                let q4_f: f32 = f32_from_u32(q4_u) - 32.0f32;

                // Signed int8 scales — sc[8h+is+{0,2,4,6}] maps DIRECTLY to §3.1's four formula
                // lines (q1 uses sc[8h+is+0], q2 uses sc[8h+is+2], q3 uses sc[8h+is+4], q4 uses
                // sc[8h+is+6]). Each is a zero-extended u8 read reconstructed to signed f32.
                let sc_u1: u32 = ptr_read_u8_zext(q, sc_base + 8u32 * h + is + 0u32);
                let sc_u2: u32 = ptr_read_u8_zext(q, sc_base + 8u32 * h + is + 2u32);
                let sc_u3: u32 = ptr_read_u8_zext(q, sc_base + 8u32 * h + is + 4u32);
                let sc_u4: u32 = ptr_read_u8_zext(q, sc_base + 8u32 * h + is + 6u32);

                let mut sc_f1: f32 = f32_from_u32(sc_u1);
                if sc_u1 >= 128u32 { sc_f1 = sc_f1 - 256.0f32; }
                let mut sc_f2: f32 = f32_from_u32(sc_u2);
                if sc_u2 >= 128u32 { sc_f2 = sc_f2 - 256.0f32; }
                let mut sc_f3: f32 = f32_from_u32(sc_u3);
                if sc_u3 >= 128u32 { sc_f3 = sc_f3 - 256.0f32; }
                let mut sc_f4: f32 = f32_from_u32(sc_u4);
                if sc_u4 >= 128u32 { sc_f4 = sc_f4 - 256.0f32; }

                // Kernel-matching associativity: (d * sc_f) * q_f (matches the CPU oracle).
                let w1: f32 = (d * sc_f1) * q1_f;
                let w2: f32 = (d * sc_f2) * q2_f;
                let w3: f32 = (d * sc_f3) * q3_f;
                let w4: f32 = (d * sc_f4) * q4_f;

                // k indices for x access (column-of-output-major layout), per §3.1's
                // y[128h+l+{0,32,64,96}] positions.
                let k1: u32 = sb * 256u32 + 128u32 * h + l;
                let k2: u32 = k1 + 32u32;
                let k3: u32 = k1 + 64u32;
                let k4: u32 = k1 + 96u32;

                let x1: f32 = x[k1 * n_cols + col];
                let x2: f32 = x[k2 * n_cols + col];
                let x3: f32 = x[k3 * n_cols + col];
                let x4: f32 = x[k4 * n_cols + col];

                sum = sum + w1 * x1 + w2 * x2 + w3 * x3 + w4 * x4;
            }
        }
    }
    y[row * n_cols + col] = sum;
    return;
}
