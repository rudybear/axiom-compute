// examples/matmul_shared_coopmat.axc — WIP (M3.3): compiles + spirv-val clean; GPU numerics
// incorrect pending OpPhi loop support. See M3.2-coder.json retry:2 for details.
//
// Competitive tiled f16 matmul (shared-staged + coopmat).
//
// PART B: The competitive tiled matmul (AT-1620, AT-1621, AT-1622).
//
// This kernel computes one TILE_M×TILE_N×TILE_K partial sum tile:
//   - Cooperatively loads A[tile_row*TILE_M : (tile_row+1)*TILE_M, 0 : TILE_K] and
//     B[0 : TILE_K, tile_col*TILE_N : (tile_col+1)*TILE_N] from f16 SSBOs
//     into shared[f16, TILE_A_SIZE] and shared[f16, TILE_B_SIZE].
//   - workgroup_barrier() ensures all staging writes are visible.
//   - coopmat_load FROM shared (shared-source single-index emit path, AT-1614).
//   - coopmat_mul_add to produce one C tile.
//   - coopmat_store the result to C.
//
// NOTE: This kernel computes a SINGLE K-block (not a loop over K). Multi-K-block
// accumulation requires loop-carried coopmat values via OpPhi, which is deferred
// to M3.3. For the AT-1620/1622 correctness fixture, K = TILE_K (one block covers
// the full K dimension: fixture shape M=16, N=16, K=tile_k).
//
// Autotuner holes: tile_k, tile_a_size, tile_b_size are GENUINELY used (not inert).
// They parameterize:
//   - shared array sizes: shared[f16, ?tile_a_size] / shared[f16, ?tile_b_size]
//   - coopmat_load stride: ?tile_k (the shared-tile row width in elements)
//   - Guard: tile_k=16 => tile_a_size=256 (16*16), tile_k=32 => tile_a_size=512 (16*32).
//     Different tile_k produces different shared-array OpTypeArray constants AND
//     different stride constants in coopmat_load (AT-1622 structural guard).
//
// On Lavapipe: coopmat preflight returns CoopMatUnsupported (graceful skip).
// The matmul_shared_f32.axc variant runs there instead.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>`.

@kernel
@workgroup(32, 1, 1)
@cooperative_matrix
@strategy { tile_m: ?[16], tile_n: ?[16], tile_k: ?[16, 32], tile_a_size: ?[256, 512], tile_b_size: ?[256, 512] }
@intent("shared-staged coopmat f16 tiled matmul (single K-block) — PART B (AT-1620..1622)")
@complexity(O(n))
fn matmul_shared_coopmat(
    A: readonly_buffer[f16],
    B: readonly_buffer[f16],
    C: buffer[f16],
    M: u32,
    N: u32,
    K: u32
) -> void {
    // Shared staging tiles.
    // a_tile: TILE_M * TILE_K elements (f16). tile_k=16 => 256, tile_k=32 => 512.
    // b_tile: TILE_K * TILE_N elements (f16). tile_k=16 => 256, tile_k=32 => 512.
    shared a_tile: shared[f16, ?tile_a_size];
    shared b_tile: shared[f16, ?tile_b_size];

    // Warp-level tile row/column.
    let tile_row: u32 = gid(1u32);
    let tile_col: u32 = gid(0u32);
    let lane_id: u32 = subgroup_invocation_id();

    // Cooperatively stage A[tile_row, 0..TILE_K] into a_tile.
    // Each lane loads one f16 element. 32 lanes cover 32 elements per iteration.
    // For TILE_M*TILE_K total elements, each lane may load multiple elements;
    // for the fixture K=TILE_K, lane_id < 32 and 32 lanes cover 32/16=2 rows.
    let lane_row: u32 = lane_id / ?tile_k;
    let lane_col: u32 = lane_id - lane_row * ?tile_k;
    let a_global: u32 = (tile_row * 16u32 + lane_row) * K + lane_col;
    let a_shared: u32 = lane_row * ?tile_k + lane_col;
    a_tile[a_shared] = A[a_global];

    // Stage B[0..TILE_K, tile_col] into b_tile.
    let b_global: u32 = lane_row * N + (tile_col * 16u32 + lane_col);
    let b_shared: u32 = lane_row * 16u32 + lane_col;
    b_tile[b_shared] = B[b_global];

    // Barrier: ensure all staging writes are visible before coopmat loads.
    workgroup_barrier();

    // coopmat_load A and B FROM shared (shared-source single-index emit path, AT-1614).
    // Stride = shared-tile row width in ELEMENTS:
    //   A tile: stride = TILE_K (a_tile is laid out as TILE_M rows × TILE_K cols).
    //   B tile: stride = TILE_N = 16 (b_tile is TILE_K rows × TILE_N cols).
    let a_mat: matrix[f16, 16, 16, a] = coopmat_load(a_tile, 0u32, ?tile_k);
    let b_mat: matrix[f16, 16, 16, b] = coopmat_load(b_tile, 0u32, 16u32);

    // Zero accumulator + single MulAdd for the one K-block.
    let acc: matrix[f16, 16, 16, accumulator] = coopmat_zero();
    let result: matrix[f16, 16, 16, accumulator] = coopmat_mul_add(a_mat, b_mat, acc);

    // Store result to C[tile_row*TILE_M, tile_col*TILE_N].
    let c_base: u32 = (tile_row * 16u32) * N + (tile_col * 16u32);
    coopmat_store(result, C, c_base, N);

    return;
}
