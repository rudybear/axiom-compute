// examples/matmul_shared_coopmat.axc — Competitive tiled f16 matmul (shared-staged + coopmat).
//
// PART B: The competitive tiled matmul (AT-1620, AT-1621, AT-1622).
//
// Workgroup cooperatively loads A and B tiles into shared[f16, TILE_M*TILE_K] /
// shared[f16, TILE_K*TILE_N], workgroup_barrier(), then coopmat_load FROM shared
// (shared-source single-index path), coopmat_mul_add accumulate over K, second
// workgroup_barrier() (WAR — before the next K-tile overwrites the staging arrays),
// and after K, coopmat_store the accumulator.
//
// @strategy holes: tile_m / tile_n / tile_k are GENUINELY used (not inert).
// They parameterize:
//   - @workgroup dimensions
//   - shared array sizes (literal N in shared[f16, TILE_M*TILE_K])
//   - K-loop trip count (K / tile_k)
// AT-1622 asserts tile_k=16 vs 32 yield different SPIR-V AND bit-exact GPU results.
//
// Bank conflicts: shared[f16, TILE*TILE] without padding will bank-conflict on the
// 32-bank model for power-of-two tile widths. This may depress TFLOPS numbers.
// @shared_tile(pad=K) sugar (M3.2 deferred item) would fix this. The honest report
// should not be surprised by sub-peak numbers attributable to conflicts.
//
// On Lavapipe: coopmat preflight returns CoopMatUnsupported (graceful skip).
// The matmul_shared_f32.axc variant runs there instead.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>`.

@kernel
@workgroup(32, 1, 1)
@cooperative_matrix
@strategy { tile_m: ?[16], tile_n: ?[16], tile_k: ?[16, 32] }
@intent("shared-staged coopmat f16 tiled matmul — PART B competitive matmul (AT-1620..1622)")
@complexity(O(n))
fn matmul_shared_coopmat(
    A: readonly_buffer[f16],
    B: readonly_buffer[f16],
    C: buffer[f16],
    M: u32,
    N: u32,
    K: u32
) -> void {
    // Shared staging tiles.
    // a_tile: TILE_M * TILE_K = 16 * 16 = 256 f16 elements.
    // b_tile: TILE_K * TILE_N = 16 * 16 = 256 f16 elements.
    shared a_tile: shared[f16, 256];
    shared b_tile: shared[f16, 256];

    // Warp-level tile row/column.
    let tile_row: u32 = gid(1u32);
    let tile_col: u32 = gid(0u32);
    let lane_id: u32 = subgroup_invocation_id();

    // Accumulator matrix: f16 TILE_M x TILE_N.
    let mut acc: matrix[f16, 16, 16, accumulator] = coopmat_zero();

    // K-loop: iterate over K in TILE_K-sized blocks.
    let num_k_blocks: u32 = K / 16u32;
    for k_block in range(0u32, num_k_blocks) {
        // Cooperative load of A tile from SSBO into shared staging.
        // Each lane loads multiple elements (coalesced pattern).
        let a_base_row: u32 = tile_row * 16u32;
        let a_base_col: u32 = k_block * 16u32;
        let lane_row: u32 = lane_id / 16u32;
        let lane_col: u32 = lane_id - lane_row * 16u32;
        let a_global: u32 = (a_base_row + lane_row) * K + (a_base_col + lane_col);
        let a_shared: u32 = lane_row * 16u32 + lane_col;
        a_tile[a_shared] = A[a_global];

        // Cooperative load of B tile from SSBO into shared staging.
        let b_base_row: u32 = k_block * 16u32;
        let b_base_col: u32 = tile_col * 16u32;
        let b_global: u32 = (b_base_row + lane_row) * N + (b_base_col + lane_col);
        let b_shared: u32 = lane_row * 16u32 + lane_col;
        b_tile[b_shared] = B[b_global];

        // Barrier: ensure all staging writes are visible before coopmat loads.
        workgroup_barrier();

        // coopmat_load A and B FROM shared (shared-source single-index emit path).
        // The stride is the shared-tile row width in ELEMENTS (= TILE_K = 16),
        // which differs from the SSBO row stride (K).
        let a_mat: matrix[f16, 16, 16, a] = coopmat_load(a_tile, 0u32, 16u32);
        let b_mat: matrix[f16, 16, 16, b] = coopmat_load(b_tile, 0u32, 16u32);

        // Accumulate: acc += a_mat * b_mat.
        acc = coopmat_mul_add(a_mat, b_mat, acc);

        // WAR barrier: before the next iteration overwrites the staging arrays.
        workgroup_barrier();
    }

    // Store accumulator to C.
    let c_base: u32 = (tile_row * 16u32) * N + (tile_col * 16u32);
    coopmat_store(acc, C, c_base, N);

    return;
}
