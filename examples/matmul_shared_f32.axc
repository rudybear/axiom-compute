// examples/matmul_shared_f32.axc — M3.3 DONE: shared-staged f32 tiled matmul (no coopmat).
//
// Lavapipe-friendly scalar matmul (AT-1621). Same shared-staging tile structure as
// matmul_shared_coopmat.axc but pure-f32 scalar inner product (no cooperative matrix).
//
// Each workgroup computes one TILE_M×TILE_N output tile. With @workgroup(16,16,1):
//   - gl_GlobalInvocationID.x = tile_col * TILE_N + local_col (0..N-1)
//   - gl_GlobalInvocationID.y = tile_row * TILE_M + local_row (0..M-1)
//
// M3.3 index-math fix: gid(1) encodes BOTH the tile-base and the local index.
//   - tile_row (workgroup id) = gid(1) / 16  = blockIdx.y
//   - local_row (lane in tile)= gid(1) - tile_row * 16  = threadIdx.y
// Similarly for tile_col / local_col from gid(0).
// The original kernel incorrectly used gid(1) for BOTH tile_row AND local_row,
// causing `a_global_row = gid(1)*16 + gid(1)` = rows 0, 17, 34... (wrong!).
//
// The scalar acc (loop-carried via Function storage) already worked in M3.2.
// The gpu=0.0 was a kernel INDEX bug, NOT an OpPhi gap.
//
// AT-1621 fixture: M=N=K=16, single workgroup (1,1,1 dispatch), tile_k=16.
// Each thread computes one C element; 16×16=256 threads cover the full tile.
//
// strategy holes: tile_k, tile_a_size, tile_b_size.
// tile_k=16 → tile_a_size=256, tile_b_size=256.
//
// Anti-pattern #2: explicit `return;`.
// Anti-pattern #8: no `>>` (use shr/lshr for shifts).

@kernel
@workgroup(16, 16, 1)
@strategy { tile_m: ?[16], tile_n: ?[16], tile_k: ?[16, 32], tile_a_size: ?[256, 512], tile_b_size: ?[256, 512] }
@intent("shared-staged f32 tiled matmul — Lavapipe-friendly, no coopmat (AT-1621)")
@complexity(O(n))
fn matmul_shared_f32(
    A: readonly_buffer[f32],
    B: readonly_buffer[f32],
    C: buffer[f32],
    M: u32,
    N: u32,
    K: u32
) -> void {
    // Shared staging tiles for A and B.
    // tile_a_size = TILE_M * TILE_K (e.g. 16*16=256 or 16*32=512).
    // tile_b_size = TILE_K * TILE_N (e.g. 16*16=256 or 32*16=512).
    shared a_tile: shared[f32, ?tile_a_size];
    shared b_tile: shared[f32, ?tile_b_size];

    // M3.3 INDEX FIX: decode tile-base and local index from gid.
    // @workgroup(16,16,1) → gid(1) = tile_row * 16 + local_row
    // tile_row (workgroup idx) = gid(1) / 16;  local_row (thread idx) = gid(1) % 16.
    let global_row: u32 = gid(1u32);
    let global_col: u32 = gid(0u32);
    let tile_row: u32 = global_row / 16u32;
    let local_row: u32 = global_row - tile_row * 16u32;
    let tile_col: u32 = global_col / 16u32;
    let local_col: u32 = global_col - tile_col * 16u32;

    // Accumulator for this output element (scalar, loop-carried via Function storage).
    let mut acc: f32 = 0.0f32;

    // K-loop: iterate over K in TILE_K-sized blocks.
    let num_k_blocks: u32 = K / ?tile_k;
    for k_block in range(0u32, num_k_blocks) {
        // Cooperative load of A tile: each invocation loads one element.
        // A_element[k_block*tile_k + local_col, tile_row*16 + local_row]
        let a_global_row: u32 = tile_row * 16u32 + local_row;
        let a_global_col: u32 = k_block * ?tile_k + local_col;
        let a_idx: u32 = a_global_row * K + a_global_col;
        let a_tile_idx: u32 = local_row * ?tile_k + local_col;
        a_tile[a_tile_idx] = A[a_idx];

        // Cooperative load of B tile: each invocation loads one element.
        // B_element[tile_col*16 + local_col, k_block*tile_k + local_row]
        let b_global_row: u32 = k_block * ?tile_k + local_row;
        let b_global_col: u32 = tile_col * 16u32 + local_col;
        let b_idx: u32 = b_global_row * N + b_global_col;
        let b_tile_idx: u32 = local_row * 16u32 + local_col;
        b_tile[b_tile_idx] = B[b_idx];

        // Barrier: wait for all invocations to finish loading the tiles.
        workgroup_barrier();

        // Scalar inner product over the TILE_K dimension.
        for k in range(0u32, ?tile_k) {
            let a_val: f32 = a_tile[local_row * ?tile_k + k];
            let b_val: f32 = b_tile[k * 16u32 + local_col];
            acc = acc + a_val * b_val;
        }

        // WAR barrier: before the next iteration overwrites the staging arrays.
        workgroup_barrier();
    }

    // Write output: C[global_row, global_col].
    let out_idx: u32 = global_row * N + global_col;
    C[out_idx] = acc;

    return;
}
