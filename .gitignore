/target
**/*.rs.bk
Cargo.lock.bak
.pipeline/runs/
*.spv
# M4.2a: the committed upstream-package .spv IS tracked (HIGH #4; AT-3004 asserts git-tracked,
# NOT merely on-disk) — negate the blanket *.spv ignore for this one directory.
!upstream/*.spv
*.dis
*.prof
.vscode/
.idea/
*.swp
*.log
# M3.4: cloned + built llama.cpp tree (large external tree, own license) — NEVER committed.
# The A/B RESULTS (ab_results.json/.md) under .pipeline/benchmarks/m34/ ARE committed (the
# numbers are the deliverable); the large raw captures are intermediates, NOT committed.
/vendor/
.pipeline/benchmarks/m34/llamacpp_raw.txt
.pipeline/benchmarks/m34/axiom_bench_raw.txt
.pipeline/benchmarks/m34/warptile_bench.txt
.pipeline/benchmarks/m34/ablate_bench_q4km.txt
# maturin-built PyO3 extension (build artifact)
py/axiom_compute/*.so
__pycache__/
.pytest_cache/
*.pyc
