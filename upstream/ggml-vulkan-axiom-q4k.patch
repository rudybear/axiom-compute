+    // Fixed 32x32 tile (no l/m/s variants); populated only when GGML_VULKAN_AXIOM_Q4K is
+    // defined AND the device supports coopmat-KHR f32acc (ggml_vk_load_shaders / the dispatch
+    // override in ggml_vk_mul_mat_q_f16).
+#ifdef GGML_VULKAN_AXIOM_Q4K
+    vk_pipeline pipeline_matmul_q4_k_f32_cm1_axiom {};
+#endif // GGML_VULKAN_AXIOM_Q4K
     vk_matmul_pipeline2 pipeline_dequant_mul_mat_mat_f16[GGML_TYPE_COUNT];
     vk_matmul_pipeline2 pipeline_dequant_mul_mat_mat_q8_1[GGML_TYPE_COUNT];
 
@@ -4157,6 +4165,21 @@
             CREATE_MM(GGML_TYPE_Q2_K, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q2_K].f32acc, matmul_q2_k_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
             CREATE_MM(GGML_TYPE_Q3_K, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q3_K].f32acc, matmul_q3_k_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
             CREATE_MM(GGML_TYPE_Q4_K, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q4_K].f32acc, matmul_q4_k_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
+#ifdef GGML_VULKAN_AXIOM_Q4K
+            // M4.2a (AXIOM-Compute): standalone coopmat-KHR (_cm1) Q4_K f32acc substitution.
+            // ONE pipeline (AXIOM's kernel has a FIXED 32x32 tile -- no l/m/s aligned/unaligned
+            // family); the dispatch override in ggml_vk_mul_mat_q_f16 (below) replaces whichever
+            // of the SIX stock variants ggml_vk_guess_matmul_pipeline() would have returned.
+            // wg_denoms={32,32,1} matches AXIOM's @workgroup(32,1,1) + 2x2 register-blocked
+            // 32x32 output tile so ggml's {M,N,z} dispatch maps to workgroups (M/32,N/32,1).
+            extern const uint64_t matmul_q4_k_f32_cm1_axiom_len;
+            extern const unsigned char matmul_q4_k_f32_cm1_axiom_data[];
+            if (device->coopmat_acc_f32_support) {
