+                    "matmul_q4_k_f32_cm1_axiom", matmul_q4_k_f32_cm1_axiom_len, matmul_q4_k_f32_cm1_axiom_data,
+                    "main", 3, sizeof(vk_mat_mat_push_constants), {32, 32, 1}, {}, 1, false, true);
+            }
+#endif // GGML_VULKAN_AXIOM_Q4K
             CREATE_MM(GGML_TYPE_Q5_K, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q5_K].f32acc, matmul_q5_k_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
             CREATE_MM(GGML_TYPE_Q6_K, pipeline_dequant_mul_mat_mat[GGML_TYPE_Q6_K].f32acc, matmul_q6_k_f32, , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
             CREATE_MM(GGML_TYPE_IQ1_S,   pipeline_dequant_mul_mat_mat[GGML_TYPE_IQ1_S].f32acc,   matmul_iq1_s_f32,   , mmq_wg_denoms, warptile_mmq, vk_mat_mat_push_constants, 3, );
@@ -8238,6 +8261,35 @@
 
     vk_pipeline pipeline = ggml_vk_guess_matmul_pipeline(ctx, mmp, ne01, ne11, aligned, qx_needs_dequant ? f16_type : src0->type, effective_src1_type);
 
+#ifdef GGML_VULKAN_AXIOM_Q4K
+    // M4.2a (AXIOM-Compute): override the RESULT of ggml_vk_guess_matmul_pipeline with the
+    // standalone AXIOM coopmat-KHR (_cm1) Q4_K f32acc pipeline when ALL 13 guard conditions
+    // hold (fail-closed otherwise -- leaves the stock `pipeline` untouched). ONE interception
+    // point covers all SIX stock variants (l/m/s/a_l/a_m/a_s), alignment-independent. See the
+    // M4.2a milestone spec Sec.2.9 for the full guard derivation + vendor citations. This sits
+    // BEFORE the 64b-indexing swap below (condition #13 excludes oversized-A tensors that would
+    // need it). NOTE (hand-written, not yet compiled -- see REPRODUCE.md): condition #8's
+    // split_k check calls ggml_vk_guess_split_k early (mirroring the resolution at :8252) since
+    // the `split_k` local is not yet declared at this point in the function.
+    if (ctx->device->pipeline_matmul_q4_k_f32_cm1_axiom &&
+        src0->type == GGML_TYPE_Q4_K &&                                                  // #1
+        src1->type == GGML_TYPE_F32 && y_f32_kernel &&                                   // #2
+        !quantize_y &&                                                                   // #3
+        !x_non_contig &&                                                                 // #4
+        !y_non_contig &&                                                                 // #5
+        !qx_needs_dequant &&                                                             // #6
+        !qy_needs_dequant &&                                                             // #7
+        ggml_vk_guess_split_k(ctx, ne01, ne11, ne10, disable_split_k, pipeline) == 1 &&
+        (ne12 * ne13) == 1 && r2 == 1 && r3 == 1 &&                                       // #8
+        ne01 % 32 == 0 && ne11 % 32 == 0 && ne10 % 256 == 0 &&                            // #9
+        ctx->device->coopmat_support && !ctx->device->coopmat2 &&                         // #10
+        ctx->device->coopmat_acc_f32_support &&                                           // #11
+        (ggml_prec)dst->op_params[0] == GGML_PREC_F32 &&                                  // #12
+        ggml_nbytes(src0) <= ctx->device->properties.limits.maxStorageBufferRange) {      // #13
+        pipeline = ctx->device->pipeline_matmul_q4_k_f32_cm1_axiom;
+    }
+#endif // GGML_VULKAN_AXIOM_Q4K
+
     if (ggml_nbytes(src0) > ctx->device->properties.limits.maxStorageBufferRange) {
         pipeline = ggml_vk_get_64b_indexing_pipeline(ctx, pipeline);
     }
